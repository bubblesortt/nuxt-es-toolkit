{
  "name": "@bubblesortt/nuxt-es-toolkit",
  "version": "2.0.0",
  "description": "Es-toolkit auto import module for Nuxt",
  "keywords": [
    "nuxt",
    "nuxt module",
    "es-toolkit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BubbleSortt/nuxt-es-toolkit.git"
  },
  "homepage": "https://github.com/BubbleSortt/nuxt-es-toolkit#readme",
  "bugs": {
    "url": "https://github.com/BubbleSortt/nuxt-es-toolkit/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "author": {
    "name": "Alexandr Bychkin",
    "email": "bubblesorttab@gmail.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "pnpm build",
    "dev": "pnpm dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "bench": "node bench/run.mjs --root . --label current --output .bench/current.json",
    "bench:compare": "node bench/compare.mjs",
    "generate:exports": "node scripts/export-catalogue.mjs --write",
    "check:exports": "node scripts/export-catalogue.mjs --check",
    "check": "pnpm check:exports && pnpm dev:prepare && pnpm lint && pnpm test && pnpm test:types && pnpm dev:build && pnpm prepack && pnpm test:package",
    "release": "pnpm check && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:package": "publint"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "es-toolkit": "1.50.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "^24.13.3",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.2",
    "publint": "^0.3.23",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "yaml": "^2.9.0"
  }
}
